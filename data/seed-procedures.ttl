@prefix pg: <https://procedure-graph.dev/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Generic starter graph. Replace or extend this file for your project.
# The evolving working graph is data/graph.nq and should not be hand-edited.

pg:Start a pg:Procedure ;
    rdfs:label "Start" ;
    pg:kind "status" ;
    pg:description "Localization marker for the first decision step" .

pg:define-scope a pg:Procedure ;
    rdfs:label "Define scope" ;
    pg:kind "reasoning" ;
    pg:description "Identify the files, tests, and documentation in scope" .

pg:implement-change a pg:Procedure ;
    rdfs:label "Implement change" ;
    pg:kind "skill" ;
    pg:description "Make the smallest coherent code change" .

pg:update-tests a pg:Procedure ;
    rdfs:label "Update tests" ;
    pg:kind "skill" ;
    pg:description "Add or update tests for the changed behavior" .

pg:run-checks a pg:Procedure ;
    rdfs:label "Run checks" ;
    pg:kind "tool" ;
    pg:description "Run the relevant automated checks" .

pg:review-change a pg:Procedure ;
    rdfs:label "Review change" ;
    pg:kind "reasoning" ;
    pg:description "Inspect the diff and verify completeness" .

pg:commit-change a pg:Procedure ;
    rdfs:label "Commit change" ;
    pg:kind "tool" ;
    pg:command "git add -p && git commit" .

pg:publish-change a pg:Procedure ;
    rdfs:label "Publish change" ;
    pg:kind "tool" ;
    pg:command "git push" .

pg:edge-start-define-scope a pg:Edge ;
    pg:from pg:Start ; pg:to pg:define-scope ; pg:relation pg:precedes ;
    pg:condition "At the beginning of a task" ;
    pg:guidance "Write down the intended scope before editing files" ;
    pg:pitfalls "Starting implementation without a checkable objective" .
pg:edge-define-scope-implement-change a pg:Edge ;
    pg:from pg:define-scope ; pg:to pg:implement-change ; pg:relation pg:precedes ;
    pg:guidance "Keep the implementation focused on the declared scope" .
pg:edge-implement-change-update-tests a pg:Edge ;
    pg:from pg:implement-change ; pg:to pg:update-tests ; pg:relation pg:precedes ;
    pg:guidance "Update tests while the change is still fresh" .
pg:edge-update-tests-run-checks a pg:Edge ;
    pg:from pg:update-tests ; pg:to pg:run-checks ; pg:relation pg:precedes ;
    pg:guidance "Run checks that cover the touched area" .
pg:edge-run-checks-review-change a pg:Edge ;
    pg:from pg:run-checks ; pg:to pg:review-change ; pg:relation pg:precedes ;
    pg:guidance "Review failures before proceeding" .
pg:edge-review-change-commit-change a pg:Edge ;
    pg:from pg:review-change ; pg:to pg:commit-change ; pg:relation pg:precedes ;
    pg:guidance "Commit only after the diff and checks are understood" .
pg:edge-commit-change-publish-change a pg:Edge ;
    pg:from pg:commit-change ; pg:to pg:publish-change ; pg:relation pg:precedes ;
    pg:guidance "Publish the reviewed commit to the configured remote" .
